       if (!Elapsed(now, btd.phaseTick, kBtdMinActionGapMs) || !BtdMutationReady(btd, now)) return;\n            std::wstring error;\n            if (!BtdClickFixedPoint(a, kBtdCoord2X, kBtdCoord2Y, now, error)) {\n                BtdFail(a, L"TRUNG_AC_COORD2_FIRST_FAIL", error); return;\n            }