s=repl(s,'            btd.trungAcExhausted = true;\n            LogAccount(a, L"TRỪNG ÁC: không còn selection NHẬN/TRẢ sau 6 lần • chuyển sang BTĐ trong túi.");\n            BtdSetPhase(a, BtdPhase::TreasureScan, now, L"AUTO BTĐ • Trừng Ác không còn giao dịch • scan Bảo Tàng Đồ");\n            return;\n        }\n\n','            btd.trungAcExhausted = true;\n            LogAccount(a, L"TRỪNG ÁC: không còn selection NHẬN/TRẢ sau 6 lần • chuyển sang BTĐ trong túi.");\n            BtdSetPhase(a, BtdPhase::TreasureScan, now, L"AUTO BTĐ • Trừng Ác không còn giao dịch • scan Bảo Tàng Đồ");\n            return;\n        }\n\n        if (btd.phase == BtdPhase::SelectOrderGrant) {\n            if (!Elapsed(now, btd.phaseTick, 650) || !BtdMutationReady(btd, now)) return;\n            std::wstring error;\n            if (BtdClickDialog(a, L"Nhận [Trừng Ác Lệnh]|[Trừng Ác Lệnh]", error)) {\n                BtdMarkMutation(btd, now);\n                btd.dialogCycleRetries = 0;\n                BtdSetPhase(a, BtdPhase::CloseAfterOrderGrant, now,\n                    L"AUTO BTĐ • đã chọn Nhận [Trừng Ác Lệnh] • chờ ≥500ms rồi đóng NPC");\n                return;\n            }\n            if (++btd.dialogCycleRetries >= 6) {\n                BtdFail(a, L"TRUNG_AC_ORDER_GRANT_NOT_FOUND", error);\n                return;\n            }\n            btd.phaseTick = now;\n            rt.status = L"AUTO BTĐ • chưa thấy dòng Nhận [Trừng Ác Lệnh] • retry " +\n                        std::to_wstring(btd.dialogCycleRetries) + L"/6";\n            return;\n        }\n\n        if (btd.phase == BtdPhase::CloseAfterOrderGrant) {\n            if (!Elapsed(now, btd.phaseTick, kBtdMinActionGapMs) || !BtdMutationReady(btd, now)) return;\n            std::wstring error;\n            if (!BtdCloseNpcDialog(a, now, error)) {\n                if (++btd.retries >= 5) { BtdFail(a, L"TRUNG_AC_CLOSE_NPC_AFTER_ORDER_FAIL", error); return; }\n                btd.phaseTick = now;\n                rt.status = L"AUTO BTĐ • đóng NPC sau nhận lệnh retry " + std::to_wstring(btd.retries) + L"/5";\n                return;\n            }\n            btd.orderGrantDone = true;\n            BtdSetPhase(a, BtdPhase::OpenNgoGioi, now,\n                L"AUTO BTĐ • đã đóng NPC • chờ ≥500ms rồi mở lại Ngô Giới nhận nhiệm vụ");\n            return;\n        }\n\n        if (btd.phase == BtdPhase::CloseAfterQuestAccept) {\n            if (!Elapsed(now, btd.phaseTick, kBtdMinActionGapMs) || !BtdMutationReady(btd, now)) return;\n            std::wstring error;\n            if (!BtdCloseNpcDialog(a, now, error)) {\n                if (++btd.retries >= 5) { BtdFail(a, L"TRUNG_AC_CLOSE_NPC_AFTER_QUEST_FAIL", error); return; }\n                btd.phaseTick = now;\n                rt.status = L"AUTO BTĐ • đóng NPC sau nhận nhiệm vụ retry " + std::to_wstring(btd.retries) + L"/5";\n                return;\n            }\n            BtdSetPhase(a, BtdPhase::EnsureMountedForVisual, now,\n                L"AUTO BTĐ • NPC đã đóng • chuẩn bị lên ngựa");\n            return;\n        }\n\n        if (btd.phase == BtdPhase::EnsureMountedForVisual) {\n            if ((s.validMask & ValidAutoFight) && s.autoFight) {\n                if (!BtdMutationReady(btd, now)) return;\n                std::wstring error;\n                if (!BtdStopFight(a, error)) { rt.status = L"AUTO BTĐ • chờ tắt AutoFight trước lên ngựa • " + error; return; }\n                BtdMarkMutation(btd, now);\n                rt.status = L"AUTO BTĐ • đã tắt AutoFight • chờ lên ngựa";\n                return;\n            }\n            if (s.riding) {\n                BtdSetPhase(a, BtdPhase::VisualCheckRoi1, now, L"AUTO BTĐ • đang trên ngựa • check ROI vùng 1");\n                return;\n            }\n            if (!BtdMutationReady(btd, now)) return;\n            TargetProfile current{L"vị trí hiện tại", s.mapID, s.x, s.y, true};\n            if (SendDecision(a, Action::Mount, current, L"AUTO BTĐ trước scan ảnh")) {\n                BtdMarkMutation(btd, now);\n                rt.status = L"AUTO BTĐ • đã gửi lệnh lên ngựa • chờ IsRiding=1";\n            } else {\n                rt.status = L"AUTO BTĐ • chờ lệnh lên ngựa đủ điều kiện";\n            }\n            return;\n        }\n\n        if (btd.phase == BtdPhase::VisualCheckRoi1) {\n            if (!Elapsed(now, btd.lastPollTick, kBtdVisualPollMs)) return;\n            btd.lastPollTick = now;\n            std::wstring error;\n            trungac_visual::Match first{}, second{};\n            if (!BtdScanVisual(a, trungac_visual::kResRoi1Image1, kBtdRoi1,\n                               kBtdRoi1Threshold, first, error)) {\n                rt.status = L"AUTO BTĐ • capture ROI1 lỗi • " + error; return;\n            }\n            if (first.found) {\n                if (!BtdMutationReady(btd, now)) return;\n                if (!BtdClickVisualMatch(a, first, now, error)) { BtdFail(a, L"TRUNG_AC_ROI1_IMAGE1_CLICK_FAIL", error); return; }\n                btd.visualDragCount = 0;\n                BtdSetPhase(a, BtdPhase::VisualFindOrderFirst, now,\n                    L"AUTO BTĐ • ROI1=ảnh1 • đã click tâm ảnh • tìm Trừng Ác Lệnh");\n                return;\n            }\n            if (!BtdScanVisual(a, trungac_visual::kResRoi1Image2, kBtdRoi1,\n                               kBtdRoi1Threshold, second, error)) {\n                rt.status = L"AUTO BTĐ • capture ROI1 ảnh2 lỗi • " + error; return;\n            }\n            if (second.found) {\n                if (!BtdMutationReady(btd, now)) return;\n                if (!BtdClickFixedPoint(a, kBtdCoord1X, kBtdCoord1Y, now, error)) {\n                    BtdFail(a, L"TRUNG_AC_ROI1_IMAGE2_COORD1_FAIL", error); return;\n                }\n                btd.visualDragCount = 0;\n                BtdSetPhase(a, BtdPhase::VisualFindOrderFirst, now,\n                    L"AUTO BTĐ • ROI1=ảnh2 • đã click tọa 1 • tìm Trừng Ác Lệnh");\n                return;\n            }\n            if (Elapsed(now, btd.phaseTick, 12000)) {\n                BtdFail(a, L"TRUNG_AC_ROI1_NO_MATCH",\n                    L"ROI1 không thấy ảnh1/ảnh2 sau 12 giây");\n                return;\n            }\n            rt.status = L"AUTO BTĐ • ROI1 chưa thấy ảnh1/ảnh2 • đang scan";\n            return;\n        }\n\n        if (btd.phase == BtdPhase::VisualFindOrderFirst ||\n            btd.phase == BtdPhase::VisualFindOrderSecond) {\n            if (!Elapsed(now, btd.lastPollTick, kBtdVisualPollMs)) return;\n            btd.lastPollTick = now;\n            const bool secondPass = btd.phase == BtdPhase::VisualFindOrderSecond;\n            std::wstring error;\n            trungac_visual::Match order{};\n            if (!BtdScanVisual(a, trungac_visual::kResRoi2Order, kBtdRoi2,\n                               kBtdRoi2Threshold, order, error)) {\n                rt.status = L"AUTO BTĐ • scan ROI2 lỗi • " + error; return;\n            }\n            if (order.found) {\n                if (!BtdMutationReady(btd, now)) return;\n                if (!BtdClickVisualMatch(a, order, now, error)) {\n                    BtdFail(a, L"TRUNG_AC_ORDER_VISUAL_CLICK_FAIL", error); return;\n                }\n                btd.visualDragCount = 0;\n                BtdSetPhase(a, secondPass ? BtdPhase::VisualUseSecond : BtdPhase::VisualUseFirst, now,\n                    secondPass ? L"AUTO BTĐ • thấy lệnh bài lần 2 • đã click tâm ảnh"\n                               : L"AUTO BTĐ • thấy lệnh bài lần 1 • đã click tâm ảnh");\n                return;\n            }\n            if (btd.visualDragCount < 2) {\n                if (!BtdMutationReady(btd, now)) return;\n                if (!BtdHiddenBagDrag(a, now, error)) {\n                    BtdFail(a, L"TRUNG_AC_BAG_HIDDEN_DRAG_FAIL", error); return;\n                }\n                ++btd.visualDragCount;\n                btd.lastPollTick = now;\n                rt.status = L"AUTO BTĐ • ROI2 chưa thấy lệnh bài • vuốt tay nải " +\n              