from pathlib import Path
import sys,base64,hashlib
root=Path(sys.argv[1] if len(sys.argv)>1 else 'work').resolve()

def read(rel): return (root/rel).read_text(encoding='utf-8-sig').replace('\r\n','\n')
def write(rel,s): (root/rel).write_text(s,encoding='utf-8')
def repl(s,old,new,label):
    n=s.count(old)
    if n!=1: raise RuntimeError(f'{label}: expected 1 anchor, found {n}')
    return s.replace(old,new,1)

