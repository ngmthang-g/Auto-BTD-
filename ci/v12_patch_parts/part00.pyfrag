s=repl(s,'            case BtdPhase::OpenNgoGioi: return L"Mở Ngô Giới";\n            case BtdPhase::SelectAccept: return a.btd.pendingTurnIn ? L"Trả Trừng Ác" : L"Nhận Trừng Ác";\n            case BtdPhase::WaitOrder: return L"Chờ Trừng Ác Lệnh";\n            case BtdPhase::UseOrder: return L"Dùng Trừng Ác Lệnh";\n            case BtdPhase::SelectOrderAction: return L"Đến địa điểm / Triệu hồi";\n            case BtdPhase::WaitOrderTravel: return L"AutoPath điểm Trừng Ác";\n','            case BtdPhase::OpenNgoGioi: return L"Mở Ngô Giới";\n            case BtdPhase::SelectAccept: return a.btd.pendingTurnIn ? L"Trả Trừng Ác" : L"Nhận Trừng Ác";\n            case BtdPhase::WaitOrder: return L"Chờ Trừng Ác Lệnh";\n            case BtdPhase::SelectOrderGrant: return L"Nhận [Trừng Ác Lệnh]";\n            case BtdPhase::CloseAfterOrderGrant: return L"Đóng NPC sau nhận lệnh";\n            case BtdPhase::CloseAfterQuestAccept: return L"Đóng NPC sau nhận nhiệm vụ";\n            case BtdPhase::EnsureMountedForVisual: return L"Lên ngựa";\n            case BtdPhase::VisualCheckRoi1: return L"Check ROI 1";\n            case BtdPhase::VisualFindOrderFirst: return L"Tìm lệnh bài lần 1";\n            case BtdPhase::VisualUseFirst: return L"Sử dụng lệnh bài lần 1";\n            case BtdPhase::VisualClickDestinationFirst: return L"Đến địa điểm lần 1";\n            case BtdPhase::VisualWaitTravel: return L"Chờ đứng im 6s";\n            case BtdPhase::VisualFindOrderSecond: return L"Tìm lệnh bài lần 2";\n            case BtdPhase::VisualUseSecond: return L"Sử dụng lệnh bài lần 2";\n            case BtdPhase::VisualClickDestinationSecond: return L"Đến địa điểm lần 2";\n            case BtdPhase::VisualCloseBag: return L"Đóng tay nải";\n            case BtdPhase::VisualFight15s: return L"Đánh quái 15s";\n            case BtdPhase::UseOrder: return L"Dùng Trừng Ác Lệnh";\n            case BtdPhase::SelectOrderAction: return L"Đến địa điểm / Triệu hồi";\n            case BtdPhase::WaitOrderTravel: return L"AutoPath điểm Trừng Ác";\n','src/controller.cpp hunk 6')
s=repl(s,'        return true;\n    }\n\n    void BtdSetPhase(Account& a, BtdPhase phase, DWORD now, const std::wstring& status) {\n        a.btd.phase = phase;\n        a.btd.phaseTick = now;\n','        return true;\n    }\n\n    static bool BtdMutationReady(const BtdRuntime& btd, DWORD now) {\n        return btd.lastMutableTick == 0 || now - btd.lastMutableTick >= kBtdMinActionGapMs;\n    }\n\n    static void BtdMarkMutation(BtdRuntime& btd, DWORD now) {\n        btd.lastMutableTick = now;\n    }\n\n    bool BtdClickFixedPoint(Account& a, int x, int y, DWORD now, std::wstring& error) {\n        ClickPoint point{x, y, kBtdVisualBaseW, kBtdVisualBaseH, true};\n        int nx = 0, ny = 0;\n        if (!NormalizeClickPointForBridge(a.game, point, nx, ny, error)) return false;\n        Response response{};\n        if (!a.bridge.Call(Command::ClickInternalPoint, nx, ny, 0, response, error, 1800)) return false;\n        BtdMarkMutation(a.btd, now);\n        return true;\n    }\n\n    bool BtdClickVisualMatch(Account& a, const trungac_visual::Match& match,\n                             DWORD now, std::wstring& error) {\n        if (!match.found || match.centerX < 0 || match.centerY < 0) {\n            error = L"Visual match chưa hợp lệ để click";\n            return false;\n        }\n        RECT rc{};\n        if (!GetClientRect(a.game.window, &rc)) { error = L"Không đọc được client rect cho visual click"; return false; }\n        const int w = rc.right - rc.left, h = rc.bottom - rc.top;\n        if (w <= 0 || h <= 0 || match.centerX >= w || match.centerY >= h) {\n            error = L"Tâm visual match nằm ngoài client";\n            return false;\n        }\n        const int nx = fixed_slot_sell_logic::NormalizeClientCoordinate(match.centerX, w);\n        const int ny = fixed_slot_sell_logic::NormalizeClientCoordinate(match.centerY, h);\n        if (nx < 0 || ny < 0) { error = L"Không chuẩn hóa được tâm visual match"; return false; }\n        Response response{};\n        if (!a.bridge.Call(Command::ClickInternalPoint, nx, ny, 0, response, error, 1800)) return false;\n        BtdMarkMutation(a.btd, now);\n        return true;\n    }\n\n    bool BtdHiddenBagDrag(Account& a, DWORD now, std::wstring& error) {\n        ClickPoint start{kBtdDragStartX, kBtdDragStartY, kBtdVisualBaseW, kBtdVisualBaseH, true};\n        ClickPoint end{kBtdDragEndX, kBtdDragEndY, kBtdVisualBaseW, kBtdVisualBaseH, true};\n        int sx = 0, sy = 0, ex = 0, ey = 0;\n        if (!NormalizeClickPointForBridge(a.game, start, sx, sy, error) ||\n            !NormalizeClickPointForBridge(a.game, end, ex, ey, error)) return false;\n        const int packedEnd = ((ex & 0xffff) << 16) | (ey & 0xffff);\n        Response response{};\n        if (!a.bridge.Call(Command::DragInternalPoint, sx, sy, packedEnd, response, error, 2200)) return false;\n        BtdMarkMutation(a.btd, now);\n        return true;\n    }\n\n    bool BtdCloseNpcDialog(Account& a, DWORD now, std::wstring& error) {\n        Response response{};\n        if (!a.bridge.Call(Command::CloseNpcDialog, 0, 0, 0, response, error, 1800)) return false;\n        if (response.resultCode == static_cast<std::int32_t>(ActionResult::UiClosed))\n            BtdMarkMutation(a.btd, now);\n        return true;\n    }\n\n    bool BtdScanVisual(Account& a, int resourceId, const trungac_visual::Roi& roi,\n                       double threshold, trungac_visual::Match& match, std::wstring& error) {\n        return trungac_visual::Scan(a.game.window, resourceId, roi, threshold, match, error);\n    }\n\n    void BtdSetPhase(Account& a, BtdPhase phase, DWORD now, const std::wstring& status) {\n        a.btd.phase = phase;\n        a.btd.phaseTick = now;\n','src/controller.cpp hunk 7')
s=repl(s,'        }\n\n        if (btd.phase == BtdPhase::GoNgoGioi) {\n            TargetProfile target{L"Ngô Giới", kTrungAcMapID, btd.ngoGioiX, btd.ngoGioiY, true};\n            bool arrived = false; (void)BtdTravel(a, now, target, L"Ngô Giới", arrived, 140);\n            if (arrived) BtdSetPhase(a, BtdPhase::OpenNgoGioi, now,\n','        }\n\n        if (btd.phase == BtdPhase::GoNgoGioi) {\n            if (!BtdMutationReady(btd, now)) return;\n            TargetProfile target{L"Ngô Giới", kTrungAcMapID, btd.ngoGioiX, btd.ngoGioiY, true};\n            bool arrived = false; (void)BtdTravel(a, now, target, L"Ngô Giới", arrived, 140);\n            if (arrived) BtdSetPhase(a, BtdPhase::OpenNgoGioi, now,\n','src/controller.cpp hunk 8')
s=repl(s,'        }\n\n        if (btd.phase == BtdPhase::OpenNgoGioi) {\n            if (!Elapsed(now, btd.phaseTick, 450)) return;\n            Response response{}; std::wstring error;\n            if (!a.bridge.Call(Command::ClickNpc, kTrungAcNpcID, 0, 0, response, error, 1800)) {\n                if (++btd.retries >= 5) { BtdFail(a, L"NPC_NOT_FOUND", error); return; }\n                btd.phaseTick = now; rt.status = L"AUTO BTĐ • mở Ngô Giới retry " + std::to_wstring(btd.retries) + L"/5"; return;\n            }\n            BtdSetPhase(a, BtdPhase::SelectAccept, now,\n                btd.pendingTurnIn ? L"AUTO BTĐ • tìm Trả nhiệm vụ" : L"AUTO BTĐ • tìm Nhận nhiệm vụ");\n            return;\n        }\n\n        if (btd.phase == BtdPhase::SelectAccept) {\n            if (!Elapsed(now, btd.phaseTick, 650)) return;\n\n            if (btd.pendingTurnIn) {\n                std::wstring error;\n                if (BtdClickDialog(a, L"Trả nhiệm vụ|Nhận thưởng|Hoàn thành|[TRẢ]", error)) {\n                    std::wstring stopError; (void)BtdStopFight(a, stopError);\n                    btd.pendingTurnIn = false;\n                    btd.summonedMonsterRoleID = 0;\n                    btd.summonedTargetSeen = false;\n                    ++btd.completedTrungAc;\n','        }\n\n        if (btd.phase == BtdPhase::OpenNgoGioi) {\n            if (!Elapsed(now, btd.phaseTick, kBtdMinActionGapMs) || !BtdMutationReady(btd, now)) return;\n            Response response{}; std::wstring error;\n            if (!a.bridge.Call(Command::ClickNpc, kTrungAcNpcID, 0, 0, response, error, 1800)) {\n                if (++btd.retries >= 5) { BtdFail(a, L"NPC_NOT_FOUND", error); return; }\n                btd.phaseTick = now; rt.status = L"AUTO BTĐ • mở Ngô Giới retry " + std::to_wstring(btd.retries) + L"/5"; return;\n            }\n            BtdMarkMutation(btd, now);\n            if (btd.pendingTurnIn) {\n                BtdSetPhase(a, BtdPhase::SelectAccept, now, L"AUTO BTĐ • tìm Trả nhiệm vụ");\n            } else if (!btd.orderGrantDone) {\n                BtdSetPhase(a, BtdPhase::SelectOrderGrant, now, L"AUTO BTĐ • tìm dòng Nhận [Trừng Ác Lệnh]");\n            } else {\n                BtdSetPhase(a, BtdPhase::SelectAccept, now, L"AUTO BTĐ • tìm Nhận nhiệm vụ");\n            }\n            return;\n        }\n\n        if (btd.phase == BtdPhase::SelectAccept) {\n            if (!Elapsed(now, btd.phaseTick, 650) || !BtdMutationReady(btd, now)) return;\n\n            i